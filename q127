#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
int main() {
    char filename[100];
    FILE *file;
    int ch;
    int characters = 0;
    int words = 0;
    int lines = 0;
    int in_word = 0;
    printf("Enter the file name: ");
    scanf("%s", filename);
    file = fopen(filename, "r");
    if (file == NULL) {
        printf("Error: Could not open file '%s'\n", filename);
        return 1;
    }
    while ((ch = fgetc(file)) != EOF) {
        characters++;
        if (ch == '\n') {
            lines++;
        }
        if (isspace(ch)) {
            in_word = 0;
        } else if (in_word == 0) {
            in_word = 1;
            words++;
        }
    }
    if (characters > 0 && ch != '\n') {
        lines++;
    }
    fclose(file);
    printf("Total Characters: %d\n", characters);
    printf("Total Words: %d\n", words);
    printf("Total Lines: %d\n", lines);
    return 0;
}
